{
    "name": "jeffersongoncalves/filament-mail-editor",
    "description": "Visual email template builder for Filament v3 with drag-and-drop blocks, live preview, and table-based HTML export.",
    "keywords": [
        "laravel",
        "filament",
        "email",
        "template",
        "builder",
        "editor",
        "drag-and-drop"
    ],
    "homepage": "https://github.com/jeffersongoncalves/filament-mail-editor",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^3.3",
        "jeffersongoncalves/laravel-mail-editor": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "livewire/livewire": "^3.0",
        "nunomaduro/collision": "^8.1",
        "nunomaduro/pao": "1.1.5",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.34|^3.7|^4.0",
        "pestphp/pest-plugin-livewire": "^2.1|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\FilamentMailEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\FilamentMailEditor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\FilamentMailEditor\\FilamentMailEditorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
